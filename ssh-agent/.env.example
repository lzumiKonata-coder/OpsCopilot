# ====================================================================
# SmartOps OpsAgent 大模型环境变量配置示例
# 复制本文件为 .env 并在下方填入您真实的 API Key 即可直接生效
# ====================================================================

# 1. 大模型 API Key
LLM_API_KEY=

# 2. 大模型服务 Base URL 
# 常用兼容端点示例：
# - 智谱 AI (GLM): https://open.bigmodel.cn/api/paas/v4
# - DeepSeek: https://api.deepseek.com/v1
# - 阿里百炼/通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
# - Moonshot/Kimi: https://api.moonshot.cn/v1
# - 本地 Ollama: http://localhost:11434/v1
# - OpenAI 原生: https://api.openai.com/v1
LLM_BASE_URL=

# 3. 调用的模型名称 
LLM_MODEL=

# 4. 平台数据与凭据对称加密主密钥 (生产环境强烈建议配置，32字节安全随机字符串)
# 未配置时系统将自动生成并持久化到本地 .smartops_secret_key 文件
# 生成方式示例：openssl rand -hex 32
SMARTOPS_SECRET_KEY=
